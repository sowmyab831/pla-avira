{
  "name": "AviraApp",
  "displayName": "Avira",
  "expo": {
    "name": "Avira",
    "slug": "avira-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "avira",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.avira.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Avira needs camera access to scan documents and receipts",
        "NSPhotoLibraryUsageDescription": "Avira needs photo library access to upload documents",
        "NSFaceIDUsageDescription": "Avira uses Face ID for secure authentication",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.avira.app",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": "http://192.168.86.33:30000",
      "eas": {
        "projectId": "avira-personal-assistant"
      }
    },
    "owner": "avira",
    "privacy": "unlisted",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
