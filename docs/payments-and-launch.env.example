# Example only. Store real values in your deployment's secret store.
# Defaults are deliberately disabled; do not expose test billing as production.
AVIRA_PAYMENTS_ENABLED=false
AVIRA_PUBLIC_URL=https://your-approved-domain.example
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_US_PREMIUM=
STRIPE_PRICE_US_ENTERPRISE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_IN_PREMIUM=
RAZORPAY_PLAN_IN_ENTERPRISE=
AVIRA_ENABLE_ACTIVATION_KEYS=false
AVIRA_TEST_KEY_PREMIUM=
AVIRA_TEST_KEY_ENTERPRISE=
AVIRA_TEST_KEY_FREE=
# Nexus-era Ollama client limits, per worker. Other legacy clients need migration.
AVIRA_LLM_CONCURRENCY=2
AVIRA_LLM_MAX_INPUT_CHARS=24000
AVIRA_LLM_MAX_OUTPUT_TOKENS=1024
